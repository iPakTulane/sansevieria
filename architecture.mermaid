graph TD
    %% Main Entry Points
    Index(index.html - Home)

    %% Global Navigation Links
    Nav[Global Navigation]
    
    Index --> Nav
    Nav --> Catalog(catalog.html)
    Nav --> About(about.html)
    Nav --> Team(team.html)
    Nav --> Contact(contact.html)

    %% Dropdown Menu
    Nav --> Dropdown[More Dropdown]
    Dropdown --> Varieties(varieties.html)
    Dropdown --> Care(care.html)
    Dropdown --> Problems(problems.html)
    Dropdown --> Blog(blog.html)

    %% E-commerce Flow
    Catalog --> Product(product.html)
    Product --> Cart(cart.html)
    Nav --> Cart
    Cart --> Checkout(checkout.html)
    Checkout --> Confirmation(confirmation.html)

    %% User Flow
    Nav --> Auth(auth.html - Login/Register)
    Auth --> Dashboard(dashboard.html)
    Nav --> Dashboard

    %% Supporting Utilities Structure
    subgraph Python Utilities [ Maintenance & Batch Processing Scripts ]
         direction LR
         H[update_headers.py] -->|Updates all HTML headers| HTMLFiles[(All .html Files)]
         L[update_links.py] -->|Resolves placeholder routes| HTMLFiles
         F[fix_links.py] -->|Fixes routing structs| HTMLFiles
         font[update_fonts.py] -->|Standardizes typography| HTMLFiles
    end

    %% Apply visual styling
    classDef page fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef util fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;
    
    class Index,Catalog,About,Team,Contact,Varieties,Care,Problems,Blog,Product,Cart,Checkout,Confirmation,Auth,Dashboard page;
    class H,L,F,font util;
